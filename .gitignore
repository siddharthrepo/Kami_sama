# Large artifacts must not be committed to git. The assignment requires datasets,
# tokenized corpora and checkpoints to live on Google Drive, with shareable links in
# the README instead.

# --- Corpora (~4 GB compressed) ---
data/
hindi/data/
nepali/data/

# --- Tokenizer training samples (~180 MB each) ---
# The plain-text line samples fed to SentencePiece. Regenerated by
# scripts/train_tokenizer.py; the trained .model and .vocab files ARE committed.
*-tokenizer-input.txt

# --- Downloaded models ---
# fastText lid.176.ftz (~1 MB) is fetched on first use by common/langid.py.
models/

# --- Run logs ---
logs/
*.log

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Caches ---
.cache/
.huggingface/

# --- Editor / tooling local state ---
.claude/
.vscode/
.idea/

# Archives staged for Google Drive upload
drive_upload/
*.tar

# Staging area for the Phase 1 artifacts downloaded from Google Drive.
incoming/
